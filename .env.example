# Environment Variables for Company House PDF Downloader

# Companies House API Key
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# Google Maps API Key (for address geocoding and maps)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Worker URL for CORS proxy
WORKER_URL=https://your-worker-url.workers.dev

# Railway API Base URL
RAILWAY_API_URL=https://your-railway-api.up.railway.app