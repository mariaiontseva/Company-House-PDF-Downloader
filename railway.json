{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "startCommand": "node proxy-server.js",
    "restartPolicyType": "always",
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 10
  },
  "environments": {
    "production": {
      "PORT": 3002
    }
  }
}